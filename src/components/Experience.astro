---
import { experience, earlierExperience } from '../data/experience';
---

<section class="section" id="experience">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="section-title">14+ years building web products.</h2>

    <ol class="timeline">
      {
        experience.map((job) => (
          <li>
            <div class="meta">
              <p class="period">{job.period}</p>
              {job.location && <p class="place">{job.location}</p>}
            </div>
            <div class="body">
              <h3>
                {job.role} ·{' '}
                {job.url ? (
                  <a href={job.url} target="_blank" rel="noopener noreferrer">{job.company}</a>
                ) : (
                  job.company
                )}
              </h3>
              <p class="summary">{job.summary}</p>
              {job.highlights && (
                <ul class="highlights">
                  {job.highlights.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {job.stack && (
                <ul class="tags">
                  {job.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="subtitle">Earlier</h3>
    <ul class="earlier">
      {
        earlierExperience.map((job) => (
          <li>
            <span>{job.role} · {job.company}</span>
            <span class="period">{job.period}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .timeline > li:first-child {
    padding-top: 0;
  }

  .period {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0.2rem 0 0.25rem;
  }

  .place {
    font-size: 0.85rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  h3 a {
    text-decoration: none;
  }

  .summary {
    color: var(--muted);
    max-width: 70ch;
  }

  .highlights {
    padding-left: 1.1rem;
    margin: 0 0 1.25rem;
    max-width: 75ch;
  }

  .highlights li + li {
    margin-top: 0.45rem;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .subtitle {
    font-size: 1.05rem;
    margin: 2.5rem 0 1rem;
  }

  .earlier {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
  }

  .earlier li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px dashed var(--border);
  }

  .earlier .period {
    margin: 0;
    white-space: nowrap;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .earlier li {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
