---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projects } from '../data/projects';
---

<section class="section" id="projects">
  <div class="container">
    <p class="section-label">Earlier projects</p>
    <h2 class="section-title">Products I built before Workpath.</h2>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <Image src={project.image} alt={`Screenshot of ${project.name}`} widths={[400, 600]} sizes="(max-width: 700px) 100vw, 340px" />
            <div class="body">
              <h3>{project.name}</h3>
              <p class="summary">{project.summary}</p>
              <p class="role">{project.role}</p>
              <ul class="tags">
                {project.stack.map((tech) => <li>{tech}</li>)}
              </ul>
              {project.url && (
                <a class="visit" href={project.url} target="_blank" rel="noopener noreferrer">
                  Visit site <Icon name="external" size={14} />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
  }

  article {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  article :global(img) {
    aspect-ratio: 600 / 410;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .summary {
    margin-bottom: 0.25rem;
  }

  .role {
    color: var(--muted);
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
