---
import { profile, howIWork } from '../data/profile';
---

<section class="section" id="about">
  <div class="container">
    <p class="section-label">About</p>
    <h2 class="section-title">Backend engineer at heart, shipping features end to end.</h2>
    <div class="about">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <h3 class="subtitle">How I work</h3>
    <ol class="steps">
      {
        howIWork.map((item, index) => (
          <li class="card">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.step}</strong>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about {
    max-width: 68ch;
    font-size: 1.1rem;
  }

  .subtitle {
    font-size: 1.15rem;
    margin: 3rem 0 1.25rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .steps li {
    padding: 1.25rem;
  }

  .number {
    display: block;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .steps p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.4rem 0 0;
  }
</style>
